---
/**
 * Layout.astro — Layout principal ZE3D
 * Inclut : Navigation, contenu (slot), Footer
 *
 * Props :
 *   title       — Titre de la page (balise <title>)
 *   description — Meta description SEO (optionnel)
 *   image       — Image Open Graph (optionnel, chemin absolu)
 */

import Navigation from '../components/Navigation.astro';
import Footer     from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title:        string;
  description?: string;
  image?:       string;
  noindex?:     boolean;   // true → page exclue de l'indexation (CGV, mentions, 404)
  schemas?:     object[];  // données structurées JSON-LD propres à la page
}

const {
  title,
  description = 'ZE3D — Spécialiste du scan 3D, modélisation BIM et visualisation architecturale à Perpignan, Occitanie.',
  image       = '/og-default.jpg',
  noindex     = false,
  schemas     = [],
} = Astro.props;

/* URL canonique */
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://ze3d.fr');
/* og:image en URL absolue (requis pour les aperçus LinkedIn/WhatsApp/Facebook) */
const ogImageURL = new URL(image, Astro.site ?? 'https://ze3d.fr').href;

/* ────────────────────────────────────────────────────────────
   Données structurées JSON-LD — socle présent sur TOUTES les pages
   indexables (les pages noindex n'en reçoivent pas).
   Aligné strictement sur le contenu visible — aucune donnée inventée.
   ──────────────────────────────────────────────────────────── */

/* Identité de l'entreprise (LocalBusiness / prestataire de services) */
const orgLd = {
  '@context':    'https://schema.org',
  '@type':       'ProfessionalService',
  '@id':         'https://ze3d.fr/#organization',
  name:          'ZE3D',
  description:   'Spécialiste du scan 3D, de la modélisation BIM (Revit) et de la visualisation architecturale. Relevé numérique, maquette numérique et rendu 3D photoréaliste à Perpignan et en France.',
  url:           'https://ze3d.fr',
  telephone:     '+33673042128',
  email:         'contact@ze3d.fr',
  image:         'https://ze3d.fr/og-default.jpg',
  logo:          'https://ze3d.fr/logo-fond-clair.png',
  foundingDate:  '2026-04-01',
  founder: {
    '@type': 'Person',
    '@id':   'https://ze3d.fr/a-propos/#person',
    name:    'Emmanuel Zerdoun',
  },
  address: {
    '@type':          'PostalAddress',
    addressLocality:  'Perpignan',
    postalCode:       '66000',
    addressRegion:    'Occitanie',
    addressCountry:   'FR',
  },
  areaServed: [
    { '@type': 'City',               name: 'Perpignan' },
    { '@type': 'AdministrativeArea', name: 'Pyrénées-Orientales' },
    { '@type': 'AdministrativeArea', name: 'Occitanie' },
    { '@type': 'Country',            name: 'France' },
  ],
  knowsAbout: [
    'Scan-to-BIM', 'Relevé numérique', 'Nuage de points', 'Scanner laser 3D / LiDAR',
    'Modélisation BIM', 'Autodesk Revit', 'Maquette numérique', 'Export IFC',
    'Visualisation architecturale', 'Rendu 3D photoréaliste',
  ],
  identifier: { '@type': 'PropertyValue', name: 'SIREN', value: '812525103' },
  vatID:      'FR47812525103',
  contactPoint: {
    '@type':            'ContactPoint',
    contactType:        'customer service',
    telephone:          '+33673042128',
    email:              'contact@ze3d.fr',
    areaServed:         'FR',
    availableLanguage:  'French',
  },
};

/* Le site lui-même */
const websiteLd = {
  '@context':  'https://schema.org',
  '@type':     'WebSite',
  '@id':       'https://ze3d.fr/#website',
  name:        'ZE3D',
  url:         'https://ze3d.fr',
  inLanguage:  'fr-FR',
  publisher:   { '@id': 'https://ze3d.fr/#organization' },
};

/* Liste finale injectée dans le <head> (socle + schémas de la page) */
const jsonLdBlocks = noindex ? [] : [orgLd, websiteLd, ...schemas];
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- ── Méta de base ─────────────────────────────────────── -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon (nouvelle identité) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- ── Performance polices ──────────────────────────────── -->
    <!-- Préconnexion aux serveurs Google Fonts (DM Sans chargé via @import
         dans global.css) : ouvre la connexion en avance, page plus rapide. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Préchargement de la police de marque locale (utilisée dès la nav). -->
    <link rel="preload" as="font" type="font/otf" href="/fonts/Nasalization.otf" crossorigin />

    <!-- ── SEO ──────────────────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── Open Graph / Twitter Card ───────────────────────── -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:site_name"   content="ZE3D" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!-- ── Couleur thème navigateur mobile ──────────────────── -->
    <meta name="theme-color" content="#1A1A2E" />

    <!-- ── Données structurées JSON-LD (SEO / GEO) ──────────── -->
    {jsonLdBlocks.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body>
    <!-- Navigation fixe — toujours visible -->
    <Navigation />

    <!-- Décalage pour compenser la nav fixe -->
    <div class="layout-content">
      <slot />
    </div>

    <!-- Footer sombre -->
    <Footer />
  </body>
</html>

<style is:global>
  /* ============================================================
     Styles globaux injectés par le layout
     ============================================================ */

  /* Décale le contenu pour ne pas être masqué par la nav fixe */
  .layout-content {
    padding-top: var(--nav-height, 72px);
    min-height:  calc(100vh - var(--nav-height, 72px));
  }
</style>
