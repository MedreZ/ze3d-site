---
/**
 * index.astro — Page d'accueil ZE3D — Refonte fond clair 2025
 * Sections : Hero · Prestations · À propos · Stats · Réalisations · CTA final
 */
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
---

<Layout
  title="ZE3D — Scan 3D, BIM & Visualisation | Perpignan, Occitanie"
  image="/og-ze3d-card.jpg"
  description="ZE3D, spécialiste du scan 3D, modélisation BIM et visualisation architecturale à Perpignan. 15 ans d'expertise au service des professionnels de la construction en Occitanie."
>
  <SplashScreen />
  <main>

    <!-- ============================================================
         1. HERO SECTION — fond blanc
         ============================================================ -->
    <section class="hero" aria-label="Introduction ZE3D">
      <div class="container hero-inner">

        <!-- Colonne gauche : texte (52%) -->
        <div class="hero-content">
          <span class="hero-badge">Relevé · Maquette Numérique · Rendus</span>

          <h1 class="hero-title">
            Votre projet,<br />
            modélisé avec<br />
            <em class="hero-accent">expertise.</em>
          </h1>

          <!-- Image mobile — visible uniquement sur mobile, après le titre -->
          <div class="hero-mobile-image">
            <picture>
              <source srcset="/509.webp" type="image/webp" />
              <img
                src="/509.jpg"
                alt="Coupe immeuble de bureaux — rendu 3D"
                loading="eager"
                decoding="async"
                width="800"
                height="450"
              />
            </picture>
          </div>

          <p class="hero-subtitle">
            Spécialiste en modélisation 3D et BIM Architecture depuis plus de 15 ans,
            je vous accompagne dans la réalisation des Maquettes Numériques de vos bâtiments
            — depuis le relevé sur site jusqu'aux rendus graphiques.
          </p>

          <div class="hero-actions">
            <a href="/contact/" class="btn-primary">
              Demander un devis →
            </a>
            <a href="/prestations/" class="btn-outline">
              Prestations
            </a>
          </div>

          <p class="hero-trust">
            15 ans d'expérience · Perpignan / France · Réponse sous 48h
          </p>
        </div>

        <!-- Colonne droite : photo (48%) -->
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-image-wrap">
            <picture>
              <source srcset="/509.webp" type="image/webp" />
              <img
                src="/509.jpg"
                alt="Coupe immeuble de bureaux — rendu 3D"
                class="hero-image"
                loading="eager"
                decoding="async"
                width="800"
                height="900"
              />
            </picture>

          </div>
        </div>

      </div>

      <div class="hero-separator" aria-hidden="true"></div>
    </section>


    <!-- ============================================================
         2. PRESTATIONS — fond #F3F5F7
         ============================================================ -->
    <section class="section prestations-section" id="prestations" aria-label="Prestations">
      <div class="container">

        <div class="section-intro text-center">
          <span class="section-label">PRESTATIONS</span>
          <h2 class="section-title">3 pôles d'expertise complémentaires</h2>
          <p class="section-subtitle">
            De la capture terrain à la maquette numérique — une expertise complète, un seul interlocuteur.
          </p>
        </div>

        <div class="prestations-grid">

          <!-- Carte 1 — Capture & Relevé -->
          <article class="prestation-card">
            <span class="card-number">01</span>
            <svg class="card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="8" width="20" height="8" rx="2"/>
              <line x1="6" y1="8" x2="6" y2="11"/>
              <line x1="9" y1="8" x2="9" y2="10"/>
              <line x1="12" y1="8" x2="12" y2="11"/>
              <line x1="15" y1="8" x2="15" y2="10"/>
              <line x1="18" y1="8" x2="18" y2="11"/>
            </svg>
            <h3 class="card-title">Relevé & Capture numérique</h3>
            <p class="card-text">
              Relevé sur site de vos bâtiments à l'aide de techniques traditionnelles (mètre, télémètre) ou de scanner laser / LiDAR dernière génération. Métrés de précision adaptés à vos besoins et à votre projet.
            </p>
            <hr class="card-separator" />
            <p class="card-livrables-label">LIVRABLES :</p>
            <div class="card-badges">
              <span class="badge">Nuage de points</span>
              <span class="badge">RCP</span>
              <span class="badge">E57</span>
              <span class="badge">Panoramas 360°</span>
              <span class="badge">Autres</span>
            </div>
            <a href="/prestations/#pole-1" class="card-link">En savoir plus →</a>
          </article>

          <!-- Carte 2 — Modélisation BIM -->
          <article class="prestation-card">
            <span class="card-number">02</span>
            <svg class="card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            <h3 class="card-title">Modélisation 3D & BIM</h3>
            <p class="card-text">
              Réalisation de la Maquette Numérique 3D (Autodesk — Revit) de vos bâtiments à partir du relevé réalisé ou de vos sources (plans DAO, autres). Intégration BIM et LOD selon vos besoins.
            </p>
            <hr class="card-separator" />
            <p class="card-livrables-label">LIVRABLES :</p>
            <div class="card-badges">
              <span class="badge">Maquette Revit</span>
              <span class="badge">Export IFC</span>
              <span class="badge">Plans DWG</span>
              <span class="badge">Plans PDF</span>
              <span class="badge">Autres</span>
            </div>
            <a href="/prestations/#pole-2" class="card-link">En savoir plus →</a>
          </article>

          <!-- Carte 3 — Rendu & Visualisation -->
          <article class="prestation-card">
            <span class="card-number">03</span>
            <svg class="card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            <h3 class="card-title">Rendu & Visualisation</h3>
            <p class="card-text">
              Mise en image de votre Maquette Numérique. Intégration des matériaux et textures. Création de vos éléments graphiques : vues 3D photoréalistes, intégration dans le site, vidéos, panoramas à 360°, autres.
            </p>
            <hr class="card-separator" />
            <p class="card-livrables-label">LIVRABLES :</p>
            <div class="card-badges">
              <span class="badge">Rendus 3D</span>
              <span class="badge">Vidéos</span>
              <span class="badge">Panoramas 360°</span>
              <span class="badge">Autres</span>
            </div>
            <a href="/prestations/#pole-3" class="card-link">En savoir plus →</a>
          </article>

        </div>
      </div>
    </section>


    <!-- ============================================================
         3. À PROPOS — fond blanc
         ============================================================ -->
    <section class="section apropos-section" id="apropos" aria-label="À propos de ZE3D">
      <div class="container">
        <div class="apropos-inner">

          <!-- Colonne gauche : image -->
          <div class="apropos-image-col">
            <div class="apropos-image-wrap">
              <picture>
                <source srcset="/photo-emmanuel.webp" type="image/webp" />
                <img
                  src="/photo-emmanuel.JPG"
                  alt="Emmanuel Zerdoun — Expert BIM ZE3D"
                  class="apropos-image"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="700"
                />
              </picture>
              <div class="apropos-badge">
                <span class="apropos-badge-number">15 ans</span>
                <span class="apropos-badge-label">d'expérience</span>
              </div>
            </div>
          </div>

          <!-- Colonne droite : texte -->
          <div class="apropos-text-col">
            <span class="section-label">À PROPOS</span>
            <h2 class="apropos-title">15 ans d'expertise BIM<br />au service de vos projets</h2>

            <!-- Photo mobile — visible uniquement sur mobile, après le titre -->
            <div class="apropos-mobile-image">
              <div class="apropos-image-wrap">
                <picture>
                  <source srcset="/photo-emmanuel.webp" type="image/webp" />
                  <img
                    src="/photo-emmanuel.JPG"
                    alt="Emmanuel Zerdoun — Expert BIM ZE3D"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="700"
                  />
                </picture>
                <div class="apropos-badge">
                  <span class="apropos-badge-number">15 ans</span>
                  <span class="apropos-badge-label">d'expérience</span>
                </div>
              </div>
            </div>

            <p class="apropos-para">
              Responsable du pôle 3D et BIM Coordinateur pendant plus de 15 ans dans un cabinet de maîtrise d'œuvre parisien,
              je crée aujourd'hui <span class="brand-ze3d">ZE3D</span> pour mettre cette expertise au service
              des professionnels du bâtiment en Occitanie et dans toute la France.
            </p>
            <p class="apropos-para">
              Basé à Perpignan, j'interviens sur site pour vos métrés et relevés numériques
              et accompagne vos projets de modélisation 3D et de rendus graphiques sur toute la France.
            </p>

            <!-- Bloc références clients -->
            <div class="apropos-references">
              <p class="apropos-references-text">
                Au cours de mes 15 ans d'expérience, j'ai eu l'opportunité d'intervenir sur des projets pour des acteurs tels que :
              </p>
              <div class="apropos-logos">
                <img src="/logos/cnav.png" alt="CNAV" class="apropos-logo" loading="lazy" decoding="async" />
                <img src="/logos/caf.svg" alt="CAF" class="apropos-logo" loading="lazy" decoding="async" />
                <img src="/logos/ofii.png" alt="OFII" class="apropos-logo" loading="lazy" decoding="async" />
                <img src="/logos/capgemini.svg" alt="Capgemini" class="apropos-logo" loading="lazy" decoding="async" />
                <img src="/logos/optical-center.svg" alt="Optical Center" class="apropos-logo" loading="lazy" decoding="async" />
                <img src="/logos/fujitsu.svg" alt="Fujitsu" class="apropos-logo" loading="lazy" decoding="async" />
              </div>
            </div>

            <ul class="apropos-list">
              <li class="apropos-list-item">
                <span class="check-icon" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>Revit Expert (15 ans de pratique)</span>
              </li>
              <li class="apropos-list-item">
                <span class="check-icon" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>Scanner laser dernière génération</span>
              </li>
              <li class="apropos-list-item">
                <span class="check-icon" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>BIM Modeleur</span>
              </li>
              <li class="apropos-list-item">
                <span class="check-icon" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>Interlocuteur unique de A à Z</span>
              </li>
            </ul>

            <a href="/a-propos/" class="btn-primary">En savoir plus →</a>
          </div>

        </div>
      </div>
    </section>


    <!-- ============================================================
         4. STATS — fond #F3F5F7
         ============================================================ -->
    <section class="stats-section" aria-label="Chiffres clés ZE3D">
      <div class="container">
        <div class="stats-grid">

          <div class="stat-item">
            <span class="stat-value stat-value--compact">15 ans</span>
            <span class="stat-primary">D'EXPÉRIENCE</span>
            <span class="stat-secondary"></span>
          </div>

          <div class="stat-divider" aria-hidden="true"></div>

          <div class="stat-item">
            <span class="stat-value">Revit</span>
            <span class="stat-primary">EXPERT</span>
            <span class="stat-secondary">Autodesk</span>
          </div>

          <div class="stat-divider" aria-hidden="true"></div>

          <div class="stat-item">
            <span class="stat-value">BIM</span>
            <span class="stat-primary">MODELEUR</span>
            <span class="stat-secondary"></span>
          </div>

          <div class="stat-divider" aria-hidden="true"></div>

          <div class="stat-item">
            <span class="stat-value stat-value--compact">Relevé 3D</span>
            <span class="stat-primary">SCANNER LASER</span>
            <span class="stat-secondary"></span>
          </div>

          <div class="stat-divider" aria-hidden="true"></div>

          <div class="stat-item">
            <span class="stat-value stat-value--compact">Perpignan</span>
            <span class="stat-primary">& FRANCE ENTIÈRE</span>
            <span class="stat-secondary"></span>
          </div>

        </div>
      </div>
    </section>


    <!-- ============================================================
         5. RÉALISATIONS — fond blanc
         ============================================================ -->
    <section class="section realisations-section" id="realisations" aria-label="Réalisations">
      <div class="container">

        <div class="section-intro text-center">
          <span class="section-label">RÉALISATIONS</span>
          <h2 class="section-title">Quelques projets en image</h2>
        </div>

        <div class="realisations-grid">

          <!-- 513 — École nocturne — 2x2 (col 1-2, row 1-2) -->
          <div class="realisation-item grid-large" style="grid-column: 1 / 3; grid-row: 1 / 3;">
            <div class="realisation-inner">
              <picture><source srcset="/realisations/513.webp" type="image/webp" /><img src="/realisations/513.jpg" alt="Complexe scolaire — vue de nuit" width="3200" height="1800" loading="lazy" decoding="async" /></picture>
              <div class="realisation-overlay">
                <span class="realisation-category">RENDU 3D</span>
                <p class="realisation-title">Complexe scolaire (vue de nuit)</p>
              </div>
            </div>
          </div>

          <!-- 507 — Cour résidence — 1x1 (col 4, row 1) -->
          <div class="realisation-item grid-small" style="grid-column: 4; grid-row: 1;">
            <div class="realisation-inner">
              <picture><source srcset="/realisations/507.webp" type="image/webp" /><img src="/realisations/507.jpg" alt="Cour intérieure — résidence" width="3200" height="1800" loading="lazy" decoding="async" /></picture>
              <div class="realisation-overlay">
                <span class="realisation-category">RENDU 3D</span>
                <p class="realisation-title">Cour intérieure — résidence</p>
              </div>
            </div>
          </div>

          <!-- 503 — Bâtiment tertiaire — 2x1 (col 3-4, row 2) -->
          <div class="realisation-item grid-wide" style="grid-column: 3 / 5; grid-row: 2;">
            <div class="realisation-inner">
              <picture><source srcset="/realisations/503.webp" type="image/webp" /><img src="/realisations/503.jpg" alt="Coupe — Immeuble de bureaux (vue de jour)" width="2180" height="1227" loading="lazy" decoding="async" /></picture>
              <div class="realisation-overlay">
                <span class="realisation-category">RENDU 3D</span>
                <p class="realisation-title">Coupe — Immeuble de bureaux (vue de jour)</p>
              </div>
            </div>
          </div>

          <!-- 501 — Immeuble de bureaux — 1x2 (col 1, row 3-4) -->
          <div class="realisation-item grid-tall" style="grid-column: 1; grid-row: 3 / 5;">
            <div class="realisation-inner">
              <picture><source srcset="/realisations/501.webp" type="image/webp" /><img src="/realisations/501.jpg" alt="Immeuble de bureaux — rendu 3D" width="2400" height="1350" loading="lazy" decoding="async" /></picture>
              <div class="realisation-overlay">
                <span class="realisation-category">RENDU 3D</span>
                <p class="realisation-title">Immeuble de bureaux</p>
              </div>
            </div>
          </div>

          <!-- 505 — Vue aérienne — 1x1 (col 2, row 4) -->
          <div class="realisation-item grid-small" style="grid-column: 2; grid-row: 4;">
            <div class="realisation-inner">
              <picture><source srcset="/realisations/505.webp" type="image/webp" /><img src="/realisations/505.jpg" alt="Vue aérienne — complexe scolaire" width="3200" height="1800" loading="lazy" decoding="async" /></picture>
              <div class="realisation-overlay">
                <span class="realisation-category">VUE AÉRIENNE</span>
                <p class="realisation-title">Vue aérienne — complexe scolaire</p>
              </div>
            </div>
          </div>

          <!-- 502 — Galilée — 2x2 (col 3-4, row 3-4) -->
          <div class="realisation-item grid-large" style="grid-column: 3 / 5; grid-row: 3 / 5;">
            <div class="realisation-inner">
              <picture><source srcset="/realisations/502.webp" type="image/webp" /><img src="/realisations/502.jpg" alt="Complexe tertiaire" width="3200" height="1800" loading="lazy" decoding="async" /></picture>
              <div class="realisation-overlay">
                <span class="realisation-category">RENDU 3D</span>
                <p class="realisation-title">Complexe tertiaire</p>
              </div>
            </div>
          </div>

        </div>

        <div class="realisations-cta text-center">
          <a href="/realisations/" class="btn-outline">Voir toutes les réalisations →</a>
        </div>

      </div>
    </section>


    <!-- ============================================================
         6. CTA FINAL — fond #F3F5F7
         ============================================================ -->
    <section class="cta-section" aria-label="Demande de contact">
      <div class="container cta-inner">

        <!-- Gauche : texte -->
        <div class="cta-text-col">
          <span class="section-label">CONTACT</span>
          <h2 class="cta-title">
            Un projet de relevé<br />
            ou de modélisation ?
          </h2>
          <p class="cta-text">
            Contactez-moi pour discuter de vos besoins et obtenir un devis personnalisé sous 48h.
          </p>
        </div>

        <!-- Droite : cartes infos + CTA -->
        <div class="cta-info-col">
          <div class="cta-info-cards">

            <div class="cta-info-card">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="cta-info-icon">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <div>
                <span class="cta-info-label">Adresse</span>
                <span class="cta-info-value">Perpignan (66), Occitanie</span>
              </div>
            </div>

            <div class="cta-info-card">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="cta-info-icon">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <div>
                <span class="cta-info-label">Email</span>
                <a href="mailto:contact@ze3d.fr" class="cta-info-value cta-info-link">contact@ze3d.fr</a>
              </div>
            </div>

            <div class="cta-info-card">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="cta-info-icon">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              <div>
                <span class="cta-info-label">Zone</span>
                <span class="cta-info-value">Toute la France</span>
              </div>
            </div>

          </div>

          <a href="/contact/" class="btn-primary cta-btn">
            Demander un devis gratuit →
          </a>
        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  /* ============================================================
     INDEX — Styles spécifiques à la page d'accueil
     ============================================================ */

  /* ─── 1. HERO ──────────────────────────────────────────────── */

  .hero {
    position:         relative;
    min-height:       90vh;
    display:          flex;
    flex-direction:   column;
    background-color: #FFFFFF;
    padding-top:      var(--nav-height, 76px);
  }

  .hero-inner {
    display:               grid;
    grid-template-columns: 52% 48%;
    align-items:           stretch;
    gap:                   0;
    flex:                  1;
    min-height:            calc(90vh - var(--nav-height, 76px));
  }

  /* Colonne texte */
  .hero-content {
    display:        flex;
    flex-direction: column;
    justify-content: center;
    padding-top:    60px;
    padding-bottom: 80px;
    padding-right:  48px;
  }

  /* Badge pill */
  .hero-badge {
    display:        inline-block;
    background:     rgba(60,94,124,0.09);
    border:         1px solid rgba(60,94,124,0.2);
    border-radius:  100px;
    padding:        5px 14px;
    font-family:    var(--font-body);
    font-size:      0.65rem;
    font-weight:    500;
    letter-spacing: 0.18em;
    color:          #3C5E7C;
    text-transform: uppercase;
    margin-bottom:  28px;
    align-self:     flex-start;
  }

  /* H1 */
  .hero-title {
    font-family:   var(--font-titre);
    font-size:     clamp(2.8rem, 5vw, 4.2rem);
    font-weight:   700;
    line-height:   1.08;
    color:         #1A2530;
    margin-bottom: 24px;
  }

  .hero-accent {
    color:      #3C5E7C;
    font-style: italic;
  }

  /* Image mobile — cachée sur desktop */
  .hero-mobile-image {
    display: none;
  }

  /* Sous-titre */
  .hero-subtitle {
    font-family:   var(--font-body);
    font-size:     1.0625rem;
    font-weight:   400;
    line-height:   1.8;
    color:         rgba(26,37,48,0.6);
    max-width:     440px;
    margin-bottom: 40px;
  }

  /* Boutons */
  .hero-actions {
    display:     flex;
    gap:         12px;
    flex-wrap:   wrap;
    align-items: center;
    margin-bottom: 20px;
  }

  /* Ligne de confiance */
  .hero-trust {
    font-family: var(--font-body);
