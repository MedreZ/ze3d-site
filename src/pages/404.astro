---
/**
 * 404.astro — Page d'erreur personnalisée ZE3D
 * Affichée automatiquement par Astro quand une URL n'existe pas
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page introuvable — ZE3D"
  description="La page que vous cherchez n'existe pas ou a été déplacée."
  noindex={true}
>
  <main class="notfound">
    <div class="container notfound-inner">

      <span class="notfound-number" aria-hidden="true">404</span>

      <span class="section-label">ERREUR 404</span>

      <h1 class="notfound-title">Page introuvable</h1>

      <p class="notfound-text">
        La page que vous cherchez n'existe pas ou a été déplacée.
        Peut-être avez-vous suivi un lien obsolète ?
      </p>

      <nav class="notfound-actions" aria-label="Retour au site">
        <a href="/" class="btn-primary">
          Retour à l'accueil
        </a>
        <a href="/prestations" class="btn-outline">
          Voir les prestations
        </a>
        <a href="/contact" class="btn-outline">
          Contact
        </a>
      </nav>

    </div>
  </main>
</Layout>


<style>
  /* ============================================================
     404 — Styles
     ============================================================ */

  .notfound {
    min-height:      calc(100vh - var(--nav-height, 76px) - 400px);
    display:         flex;
    align-items:     center;
    justify-content: center;
    background-color: #FFFFFF;
    padding:         80px 0 100px;
  }

  .notfound-inner {
    text-align: center;
    max-width:  640px;
  }

  .notfound-number {
    display:        block;
    font-family:    var(--font-titre);
    font-size:      clamp(6rem, 18vw, 11rem);
    font-weight:    700;
    line-height:    1;
    color:          #3C5E7C;
    opacity:        0.12;
    letter-spacing: -0.03em;
    margin-bottom:  -30px;
  }

  .notfound-inner .section-label {
    margin-bottom: 12px;
  }

  .notfound-title {
    font-family:   var(--font-titre);
    font-size:     clamp(2rem, 4vw, 3rem);
    font-weight:   700;
    color:         #1A2530;
    line-height:   1.2;
    margin:        0 0 20px;
  }

  .notfound-text {
    font-family: var(--font-body);
    font-size:   1.0625rem;
    line-height: 1.75;
    color:       rgba(26,37,48,0.65);
    margin:      0 auto 40px;
    max-width:   500px;
  }

  .notfound-actions {
    display:         flex;
    gap:             12px;
    justify-content: center;
    flex-wrap:       wrap;
  }


  /* ─── RESPONSIVE ───────────────────────────────────────────── */

  @media (max-width: 600px) {
    .notfound {
      padding: 60px 0 80px;
    }

    .notfound-number {
      margin-bottom: -20px;
    }

    .notfound-actions {
      flex-direction: column;
      align-items:    stretch;
    }

    .notfound-actions .btn-primary,
    .notfound-actions .btn-outline {
      width:           100%;
      justify-content: center;
    }
  }
</style>
